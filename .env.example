# ── App ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ── Database (Supabase PostgreSQL) ──────────────────
# Copy exact strings from Supabase dashboard → Project Settings → Database → Connect.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true   # pooled (app)
DIRECT_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres                                        # direct (migrations)

# ── Auth (Better Auth) ──────────────────────────────
BETTER_AUTH_SECRET=generate-a-high-entropy-secret
BETTER_AUTH_URL=https://your-app.vercel.app
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=set-once-then-rotate

# ── Email (Resend) ──────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="The Culprit <no-reply@example.com>"

# ── Bot defense (Cloudflare Turnstile) ──────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Rate limiting (Upstash Redis) ───────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Storage (Supabase Storage) ───────────────────────
# Server-only; never exposed to the client. Service-role key from Project Settings → API.
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Calendly (embed + REST integration) ─────────────
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle/30min
# REST integration (Free plan + Personal Access Token). Server-only; never exposed to the browser.
# Unset = integration reports "not configured" and endpoints return a clean disabled response.
CALENDLY_ACCESS_TOKEN=                                   # PAT from calendly.com → Integrations → API & Webhooks
CALENDLY_USER_URI=https://api.calendly.com/users/XXXXXXXX # from GET /users/me ("resource.uri")
CALENDLY_WEBHOOK_SIGNING_KEY=                            # from the webhook subscription; verifies signed webhooks
