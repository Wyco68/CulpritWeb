# ── App ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ── Database (Supabase PostgreSQL) ──────────────────
# Copy exact strings from Supabase dashboard → Project Settings → Database → Connect.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true   # pooled (app)
DIRECT_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres                                        # direct (migrations)

# ── Auth (Better Auth) ──────────────────────────────
BETTER_AUTH_SECRET=generate-a-high-entropy-secret
BETTER_AUTH_URL=https://your-app.vercel.app
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=set-once-then-rotate

# ── Email (Resend) ──────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="The Culprit <no-reply@example.com>"

# ── Bot defense (Cloudflare Turnstile) ──────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# ── Storage (Cloudflare R2) ──────────────────────────
# One bucket, categories split by folder prefix. Server-only; never exposed to the client.
# Access key from Cloudflare dashboard → R2 → Manage API tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# The bucket's public dev URL (R2 dashboard → bucket → Settings → Public Access → enable
# "r2.dev subdomain"). Deliberately not a custom domain: the project domain's DNS zone lives in a
# different Cloudflare account, so a custom-domain URL would need a CNAME coordinated across
# accounts. The r2.dev URL needs none of that and works immediately.
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# ── Calendly (embed only — no server-side integration, no PAT, no webhook) ──
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle/30min
