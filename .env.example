# ── App ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ── Database (Neon PostgreSQL) ──────────────────────
DATABASE_URL=postgresql://user:pass@host-pooler.neon.tech/neondb?sslmode=require   # pooled (app)
DIRECT_URL=postgresql://user:pass@host.neon.tech/neondb?sslmode=require            # direct (migrations)

# ── Auth (Better Auth) ──────────────────────────────
BETTER_AUTH_SECRET=generate-a-high-entropy-secret
BETTER_AUTH_URL=https://your-app.vercel.app
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=set-once-then-rotate

# ── Email (Resend) ──────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="The Culprit <no-reply@example.com>"

# ── Bot defense (Cloudflare Turnstile) ──────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Rate limiting (Upstash Redis) ───────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Storage (Cloudflare R2) ─────────────────────────
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=culprit-media
R2_PUBLIC_BASE_URL=

# ── Calendly (embed only) ───────────────────────────
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle/30min
