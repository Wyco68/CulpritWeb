// Prisma schema for "The Culprit". See PROJECT_SPEC.md §7 (internal) for the authoritative model.
// Structured profile fields are Json (list-shaped, admin-edited as a whole).

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: connection URL lives in prisma.config.ts, not here.
// PrismaClient is instantiated with a driver adapter (see src/modules/shared/lib/prisma.ts).
datasource db {
  provider = "postgresql"
}

model Profile {
  id                       String   @id @default(cuid())
  fullName                 String   @map("full_name")
  title                    String
  photoUrl                 String?  @map("photo_url")
  bio                      String?  @db.Text
  positionAffiliation      String?  @map("position_affiliation") @db.Text
  education                Json?
  fellowshipsVisiting      Json?    @map("fellowships_visiting")
  teachingRoles            Json?    @map("teaching_roles")
  teachingAwards           Json?    @map("teaching_awards")
  scholarshipsTravelAwards Json?    @map("scholarships_travel_awards")
  researchInterests        Json?    @map("research_interests")
  researchStatement        String?  @map("research_statement") @db.Text
  invitedTalks             Json?    @map("invited_talks")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("profile")
}

model Research {
  id        String   @id @default(cuid())
  title     String
  summary   String   @db.Text
  area      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("research")
}

model Publication {
  id        String   @id @default(cuid())
  title     String
  authors   String
  venue     String
  year      Int
  link      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("publication")
}

model ResearchGroup {
  id          String       @id @default(cuid())
  name        String
  description String       @db.Text
  teamMembers TeamMember[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("research_group")
}

model TeamMember {
  id              String         @id @default(cuid())
  name            String
  role            String // e.g. "PhD Candidate", "Visiting Professor"
  bio             String?        @db.Text
  photoUrl        String?        @map("photo_url")
  researchGroupId String?        @map("research_group_id")
  researchGroup   ResearchGroup? @relation(fields: [researchGroupId], references: [id], onDelete: SetNull)
  sortOrder       Int            @default(0) @map("sort_order")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([researchGroupId])
  @@map("team_member")
}

enum AppointmentStatus {
  pending
  approved
  declined
  booked
  cancelled
}

enum AppointmentSource {
  direct
  request
}

model Appointment {
  id               String            @id @default(cuid())
  requesterName    String            @map("requester_name")
  requesterEmail   String            @map("requester_email")
  researchGroup    String?           @map("research_group")
  requestedTime    DateTime?         @map("requested_time")
  topic            String?           @db.Text
  source           AppointmentSource @default(request)
  status           AppointmentStatus @default(pending)
  calendlyEventRef String?           @map("calendly_event_ref")
  // Calendly REST integration metadata (association only; the app never mutates Calendly-side data).
  calendlyEventUri     String?  @map("calendly_event_uri")
  calendlyInviteeUri   String?  @unique @map("calendly_invitee_uri")
  calendlyEventTypeUri String?  @map("calendly_event_type_uri")
  meetingUrl           String?  @map("meeting_url")
  scheduledAt          DateTime? @map("scheduled_at")
  cancelledAt          DateTime? @map("cancelled_at")
  cancelReason     String?           @map("cancel_reason") @db.Text
  cancelToken      String            @unique @map("cancel_token")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("appointment")
}

model Setting {
  key   String @id
  value Json

  @@map("setting")
}

// --- Better Auth (single admin) ---------------------------------------------------------------
// Owned by Better Auth's Prisma adapter (DB-backed cookie sessions, NOT JWT). Do not query these
// from domain code — only the auth module hands the Prisma client to the adapter.

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verification")
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      String
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}
