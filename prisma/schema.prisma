// Prisma schema for "The Culprit". See PROJECT_SPEC.md §7 (internal) for the authoritative model.
// Structured profile fields are Json (list-shaped, admin-edited as a whole).

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: connection URL lives in prisma.config.ts, not here.
// PrismaClient is instantiated with a driver adapter (see src/modules/shared/lib/prisma.ts).
datasource db {
  provider = "postgresql"
}

model Profile {
  id                       String   @id @default(cuid())
  fullName                 String   @map("full_name")
  title                    String
  photoUrl                 String?  @map("photo_url")
  bio                      String?  @db.Text
  positionAffiliation      String?  @map("position_affiliation") @db.Text
  education                Json?
  fellowshipsVisiting      Json?    @map("fellowships_visiting")
  teachingRoles            Json?    @map("teaching_roles")
  teachingAwards           Json?    @map("teaching_awards")
  scholarshipsTravelAwards Json?    @map("scholarships_travel_awards")
  researchInterests        Json?    @map("research_interests")
  researchStatement        String?  @map("research_statement") @db.Text
  invitedTalks             Json?    @map("invited_talks")
  linkedinUrl              String?  @map("linkedin_url")
  googleScholarUrl         String?  @map("google_scholar_url")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("profile")
}

model Research {
  id        String   @id @default(cuid())
  title     String
  summary   String   @db.Text
  area      String
  /// Optional external link — a project page, tool listing, or artefact repository.
  link      String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("research")
}

model Publication {
  id        String   @id @default(cuid())
  title     String
  authors   String
  venue     String
  year      Int
  /// Nullable: conference and book-chapter entries frequently have no stable public URL.
  link      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("publication")
}

model ResearchGroup {
  id          String       @id @default(cuid())
  name        String
  description String       @db.Text
  teamMembers TeamMember[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("research_group")
}

model TeamMember {
  id              String         @id @default(cuid())
  name            String
  role            String // e.g. "PhD Candidate", "Visiting Professor"
  bio             String?        @db.Text
  photoUrl        String?        @map("photo_url")
  researchGroupId String?        @map("research_group_id")
  researchGroup   ResearchGroup? @relation(fields: [researchGroupId], references: [id], onDelete: SetNull)
  sortOrder       Int            @default(0) @map("sort_order")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([researchGroupId])
  @@map("team_member")
}

// No approve/decline/book review queue, and no Calendly sync of any kind: an appointment exists
// ONLY because the admin declared it directly (Manage Appointments). `scheduled` is the only
// creatable state; `cancelled` is terminal and retained (never hard-deleted). A visitor booking
// through the Calendly embed happens entirely on Calendly's side and never reaches this table —
// see src/modules/integrations/calendly/README.md.
enum AppointmentStatus {
  scheduled
  cancelled
}

model Appointment {
  id            String            @id @default(cuid())
  /// Who the meeting is with, entered by the admin.
  requesterName String            @map("requester_name")
  /// Optional — informational only. No email is ever sent by this app for an appointment
  /// (Calendly sends its own confirmation for widget bookings; admin-declared entries send none).
  requesterEmail String?          @map("requester_email")
  researchGroup String?           @map("research_group")
  scheduledAt   DateTime          @map("scheduled_at")
  topic         String?           @db.Text
  status        AppointmentStatus @default(scheduled)
  cancelReason  String?           @map("cancel_reason") @db.Text
  /// Drives public "Upcoming Events" visibility per-appointment (admin opt-in per row; replaces
  /// the old global `upcoming_events_visible` setting — see ADR for the 2026-08-13 removal).
  isPublic      Boolean           @default(false) @map("is_public")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@index([status])
  @@index([scheduledAt])
  @@map("appointment")
}

// --- Better Auth (single admin) ---------------------------------------------------------------
// Owned by Better Auth's Prisma adapter (DB-backed cookie sessions, NOT JWT). Do not query these
// from domain code — only the auth module hands the Prisma client to the adapter.

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verification")
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      String
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}
